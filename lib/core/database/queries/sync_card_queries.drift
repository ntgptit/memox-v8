import '../tables/deck.drift';
import '../tables/card.drift';
import '../tables/tags.drift';
import '../tables/srs.drift';

-- Sync reads and writes a card in any state: a card in the Trash carries its
-- delete_batch_id to and from the server (library and study sync spec §3.1,
-- SB-S2).

syncCardRow(:id AS TEXT):
SELECT * FROM card WHERE id = :id;

-- The tags on :card_id, by tag id: the wire's tagIds.
syncCardTagIds(:card_id AS TEXT):
SELECT tag_id FROM card_tags WHERE card_id = :card_id ORDER BY tag_id;

-- A pulled card: the columns the server sends, the folded faces the adapter
-- computes, and its version.
upsertSyncedCard: INSERT INTO card $row
ON CONFLICT (id) DO UPDATE SET
  deck_id = excluded.deck_id,
  front = excluded.front,
  back = excluded.back,
  front_folded = excluded.front_folded,
  back_folded = excluded.back_folded,
  is_flagged = excluded.is_flagged,
  example = excluded.example,
  hint = excluded.hint,
  pronunciation = excluded.pronunciation,
  delete_batch_id = excluded.delete_batch_id,
  created_at = excluded.created_at,
  updated_at = excluded.updated_at,
  server_version = excluded.server_version;

-- R10: a pulled card with tagIds replaces its links.
deleteSyncedCardTags(:card_id AS TEXT):
DELETE FROM card_tags WHERE card_id = :card_id;

linkSyncedCardTag(:card_id AS TEXT, :tag_id AS TEXT):
INSERT OR IGNORE INTO card_tags (card_id, tag_id) VALUES (:card_id, :tag_id);

-- A card the server tombstoned; local cascades follow.
deleteSyncedCard(:id AS TEXT):
DELETE FROM card WHERE id = :id;

acknowledgeCard(:id AS TEXT, :server_version AS INTEGER):
UPDATE card SET server_version = :server_version WHERE id = :id;
