import 'card.drift';
import 'deck.drift';
import 'settings.drift';
import 'srs.drift';
import 'tags.drift';
import 'trash.drift';

-- App deck-sync spec §3: one pending operation per synced row. A write
-- replaces op_id (so an acknowledgement of an older push cannot remove it)
-- and keeps created_at (so a parent stays ahead of its child).
CREATE TABLE sync_outbox (
  op_id TEXT NOT NULL PRIMARY KEY,
  entity_type TEXT NOT NULL,
  entity_id TEXT NOT NULL,
  op TEXT NOT NULL CHECK (op IN ('upsert', 'delete')),
  created_at DATETIME NOT NULL,
  attempts INTEGER NOT NULL DEFAULT 0,
  -- What the server needs beyond the row and the op, as JSON: a purge's
  -- delete carries the batch it purged and the row's acknowledged version
  -- (DEV-181, server sync spec §4.1).
  payload TEXT,
  UNIQUE (entity_type, entity_id)
) AS SyncOutboxEntry;

-- Schema 14 (DEV-205): a push batch is one entity type, oldest first
-- (`pendingOutboxOfType`, `pendingDeckOutbox`); the index serves the filter
-- and the order, so a batch is a range read, never a sort of the outbox.
CREATE INDEX idx_sync_outbox_type_created ON sync_outbox (entity_type, created_at);

CREATE TABLE sync_state (
  -- `name`, not `key`: KEY is reserved in drift's SQL parser.
  name TEXT NOT NULL PRIMARY KEY,
  value TEXT NOT NULL
) AS SyncStateEntry;

-- A random version-4 UUID for op_id, written out in each trigger because
-- SQLite has no function for it.
CREATE TRIGGER deck_sync_insert AFTER INSERT ON deck
WHEN (SELECT value FROM sync_state WHERE name = 'applying_remote') IS NULL
BEGIN
  INSERT INTO sync_outbox (op_id, entity_type, entity_id, op, created_at, payload)
  VALUES (lower(hex(randomblob(4)) || '-' || hex(randomblob(2)) || '-4' || substr(hex(randomblob(2)), 2) || '-' || substr('89ab', 1 + (abs(random()) % 4), 1) || substr(hex(randomblob(2)), 2) || '-' || hex(randomblob(6))),
          'deck', new.id, 'upsert', CAST(strftime('%s', 'now') AS INTEGER), NULL)
  ON CONFLICT (entity_type, entity_id) DO UPDATE SET op_id = excluded.op_id, op = excluded.op, payload = excluded.payload;
END;

CREATE TRIGGER deck_sync_update AFTER UPDATE ON deck
WHEN (SELECT value FROM sync_state WHERE name = 'applying_remote') IS NULL
BEGIN
  INSERT INTO sync_outbox (op_id, entity_type, entity_id, op, created_at, payload)
  VALUES (lower(hex(randomblob(4)) || '-' || hex(randomblob(2)) || '-4' || substr(hex(randomblob(2)), 2) || '-' || substr('89ab', 1 + (abs(random()) % 4), 1) || substr(hex(randomblob(2)), 2) || '-' || hex(randomblob(6))),
          'deck', new.id, 'upsert', CAST(strftime('%s', 'now') AS INTEGER), NULL)
  ON CONFLICT (entity_type, entity_id) DO UPDATE SET op_id = excluded.op_id, op = excluded.op, payload = excluded.payload;
END;

CREATE TRIGGER deck_sync_delete AFTER DELETE ON deck
WHEN (SELECT value FROM sync_state WHERE name = 'applying_remote') IS NULL
BEGIN
  INSERT INTO sync_outbox (op_id, entity_type, entity_id, op, created_at, payload)
  VALUES (lower(hex(randomblob(4)) || '-' || hex(randomblob(2)) || '-4' || substr(hex(randomblob(2)), 2) || '-' || substr('89ab', 1 + (abs(random()) % 4), 1) || substr(hex(randomblob(2)), 2) || '-' || hex(randomblob(6))),
          'deck', old.id, 'delete', CAST(strftime('%s', 'now') AS INTEGER), CASE WHEN old.delete_batch_id IS NULL THEN NULL ELSE json_object('deleteBatchId', old.delete_batch_id, 'serverVersion', old.server_version) END)
  ON CONFLICT (entity_type, entity_id) DO UPDATE SET op_id = excluded.op_id, op = excluded.op, payload = excluded.payload;
END;

