-- SB-S3: tags, as cards; a card's links travel on the card, so a link change
-- queues the card (library and study sync spec §3.2).
CREATE TRIGGER tags_sync_insert AFTER INSERT ON tags
WHEN (SELECT value FROM sync_state WHERE name = 'applying_remote') IS NULL
BEGIN
  INSERT INTO sync_outbox (op_id, entity_type, entity_id, op, created_at)
  VALUES (lower(hex(randomblob(4)) || '-' || hex(randomblob(2)) || '-4' || substr(hex(randomblob(2)), 2) || '-' || substr('89ab', 1 + (abs(random()) % 4), 1) || substr(hex(randomblob(2)), 2) || '-' || hex(randomblob(6))),
          'tag', new.id, 'upsert', CAST(strftime('%s', 'now') AS INTEGER))
  ON CONFLICT (entity_type, entity_id) DO UPDATE SET op_id = excluded.op_id, op = excluded.op;
END;

CREATE TRIGGER tags_sync_update AFTER UPDATE ON tags
WHEN (SELECT value FROM sync_state WHERE name = 'applying_remote') IS NULL
BEGIN
  INSERT INTO sync_outbox (op_id, entity_type, entity_id, op, created_at)
  VALUES (lower(hex(randomblob(4)) || '-' || hex(randomblob(2)) || '-4' || substr(hex(randomblob(2)), 2) || '-' || substr('89ab', 1 + (abs(random()) % 4), 1) || substr(hex(randomblob(2)), 2) || '-' || hex(randomblob(6))),
          'tag', new.id, 'upsert', CAST(strftime('%s', 'now') AS INTEGER))
  ON CONFLICT (entity_type, entity_id) DO UPDATE SET op_id = excluded.op_id, op = excluded.op;
END;

CREATE TRIGGER tags_sync_delete AFTER DELETE ON tags
WHEN (SELECT value FROM sync_state WHERE name = 'applying_remote') IS NULL
BEGIN
  INSERT INTO sync_outbox (op_id, entity_type, entity_id, op, created_at)
  VALUES (lower(hex(randomblob(4)) || '-' || hex(randomblob(2)) || '-4' || substr(hex(randomblob(2)), 2) || '-' || substr('89ab', 1 + (abs(random()) % 4), 1) || substr(hex(randomblob(2)), 2) || '-' || hex(randomblob(6))),
          'tag', old.id, 'delete', CAST(strftime('%s', 'now') AS INTEGER))
  ON CONFLICT (entity_type, entity_id) DO UPDATE SET op_id = excluded.op_id, op = excluded.op;
