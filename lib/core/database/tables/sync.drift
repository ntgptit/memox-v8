-- BE-E7 spec §3: the commands and patches a device has not pushed yet,
-- pushed in seq order. A patch holds no values: the coordinator reads them
-- at push time, and a second patch of one field group keeps the first seq.
CREATE TABLE sync_outbox (
  seq INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  op_id TEXT NOT NULL UNIQUE,
  kind TEXT NOT NULL CHECK (kind IN ('command', 'patch')),
  command_type TEXT,
  entity_type TEXT,
  entity_id TEXT,
  patch_group TEXT,
  payload TEXT,
  affected TEXT NOT NULL DEFAULT '[]',
  created_at DATETIME NOT NULL,
  attempts INTEGER NOT NULL DEFAULT 0
) AS SyncOutboxEntry;

CREATE UNIQUE INDEX idx_sync_outbox_patch
  ON sync_outbox (entity_type, entity_id, patch_group) WHERE kind = 'patch';

CREATE TABLE sync_state (
  -- `name`, not `key`: KEY is reserved in drift's SQL parser.
  name TEXT NOT NULL PRIMARY KEY,
  value TEXT NOT NULL
) AS SyncStateEntry;
