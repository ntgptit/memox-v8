{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "memox-web",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-d",
        "web-server",
        "--web-port=8087"
      ],
      "port": 8087
    },
    {
      "name": "gallery",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8091",
        "--directory",
        "build"
      ],
      "port": 8091
    }
  ]
}
