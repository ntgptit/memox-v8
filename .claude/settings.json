{
  "permissions": {
    "ask": [
      "Workflow"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 15,
            "statusMessage": "Loading Superpowers…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "S=\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/enforce_subagent_model.py\"; if [ -f \"$S\" ]; then python \"$S\"; else printf \"%s\" \"{\\\"hookSpecificOutput\\\":{\\\"hookEventName\\\":\\\"PreToolUse\\\",\\\"permissionDecision\\\":\\\"deny\\\",\\\"permissionDecisionReason\\\":\\\"subagent-model guard missing at $S - refusing to spawn a subagent unguarded\\\"}}\"; fi",
            "timeout": 15,
            "statusMessage": "Pinning subagent to Sonnet…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/check_design_tokens.py\"",
            "timeout": 15,
            "statusMessage": "Checking design tokens…"
          }
        ]
      }
    ]
  }
}
