      "css": ".ds-chip{display:inline-flex;align-items:center;height:28px;padding:0 8px;border-radius:999px;background:var(--color-on-primary);color:var(--color-on-surface);box-shadow:inset 0 0 0 1px var(--color-outline-variant);font:600 12px \"Plus Jakarta Sans\",sans-serif;letter-spacing:0.1px} .ds-chip-on{background:var(--color-primary);color:var(--color-on-primary);box-shadow:none}"
    },
    {
