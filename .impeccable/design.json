  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one indigo action per decision. 48 tall, r12; pressed overlay 12%; disabled 0.38 opacity.",
      "html": "<button class=\"ds-btn-primary\">Start session</button>",
      "css": ".ds-btn-primary{font-family:\"Plus Jakarta Sans\",sans-serif;font-size:14px;font-weight:600;letter-spacing:0.1px;height:48px;padding:0 16px;border:0;border-radius:12px;background:var(--color-primary);color:var(--color-on-primary);} .ds-btn-primary:active{filter:brightness(0.88)} .ds-btn-primary:focus-visible{outline:2px solid var(--color-primary);outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Quiet alternative on a container fill.",
      "html": "<button class=\"ds-btn-secondary\">Cancel</button>",
      "css": ".ds-btn-secondary{font-family:\"Plus Jakarta Sans\",sans-serif;font-size:14px;font-weight:600;letter-spacing:0.1px;height:48px;padding:0 16px;border:0;border-radius:12px;background:var(--color-surface-container);color:var(--color-on-surface);} .ds-btn-secondary:active{filter:brightness(0.88)} .ds-btn-secondary:focus-visible{outline:2px solid var(--color-primary);outline-offset:2px}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Ghost action in primary ink with a 1px outlineEdge: outline-variant in light, outline pulled 25% toward on-surface in dark (critique 2026-09-30 part 1).",
      "html": "<button class=\"ds-btn-outline\">Edit deck</button>",
      "css": ".ds-btn-outline{font-family:\"Plus Jakarta Sans\",sans-serif;font-size:14px;font-weight:600;letter-spacing:0.1px;height:48px;padding:0 16px;border:0;border-radius:12px;background:transparent;color:var(--color-primary);box-shadow:inset 0 0 0 1px var(--color-outline-variant);} .ds-btn-outline:active{filter:brightness(0.88)} .ds-btn-outline:focus-visible{outline:2px solid var(--color-primary);outline-offset:2px}"
    },
    {
      "name": "Destructive Button",
      "kind": "button",
      "refersTo": "button-destructive",
      "description": "Solid destructive fill, used only to confirm a destructive dialog.",
      "html": "<button class=\"ds-btn-danger\">Delete</button>",
      "css": ".ds-btn-danger{font-family:\"Plus Jakarta Sans\",sans-serif;font-size:14px;font-weight:600;letter-spacing:0.1px;height:48px;padding:0 16px;border:0;border-radius:12px;background:var(--color-error);color:var(--color-on-primary);} .ds-btn-danger:active{filter:brightness(0.88)} .ds-btn-danger:focus-visible{outline:2px solid var(--color-primary);outline-offset:2px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "text-field",
      "description": "52 tall, muted fill that lightens on focus, ghost edge, primary-ink edge on focus, error edge with a message below.",
      "html": "<input class=\"ds-input\" placeholder=\"Term\">",
      "css": ".ds-input{box-sizing:border-box;height:52px;padding:0 12px;width:260px;font:400 14px \"Plus Jakarta Sans\",sans-serif;color:var(--color-on-surface);background:var(--color-surface-container-low);border:1px solid var(--color-outline-variant);border-radius:12px;outline:none} .ds-input::placeholder{color:var(--color-on-surface-variant)} .ds-input:focus-visible{background:var(--color-on-primary);border-color:var(--color-primary)}"
    },
