      "html": "<div class=\"ds-card\"><strong>Spanish basics</strong><p>42 cards</p></div>",
      "css": ".ds-card{padding:20px;width:240px;background:var(--color-on-primary);border-radius:12px;box-shadow:0 1px 2px color-mix(in srgb, var(--color-shadow) 4%, transparent);font:400 14px/1.5 \"Plus Jakarta Sans\",sans-serif;color:var(--color-on-surface)} .ds-card strong{font:500 16px/1.5 \"Plus Jakarta Sans\",sans-serif} .ds-card p{margin:0;color:var(--color-on-surface-variant)}"
    },
    {
      "name": "Filter Chip",
      "kind": "chip",
      "refersTo": "filter-chip",
      "description": "28 tall pill; selected swaps fill to primary and ink to on-primary.",
