  "narrative": {
    "northStar": "The Quiet Study Desk",
    "overview": "MemoX should feel like a quiet, focused study space. Two themes from one structure: Indigo Day and Indigo Night. Component philosophy: \"Calm and exact\".",
    "keyCharacteristics": [
      "One sans family (Plus Jakarta Sans), seven roles, tight-tracked for headings and figures.",
      "Tonal surfaces plus a 1px border hairline; shadows are whisper-quiet.",
      "One radius (12) for every in-flow surface; larger radii only for surfaces that float.",
      "Phone-first, 16dp gutter, single content column, 48dp touch targets everywhere.",
      "Every text and edge colour is contrast-tested in both themes; the pairs below AA are recorded exceptions."
    ],
    "rules": [
      {
        "name": "The One Indigo Rule",
        "body": "Indigo means \"act\". A primary fill appears once per decision; the rest of the screen is neutral.",
        "section": "colors"
      },
      {
        "name": "The Green Means Progress Rule",
        "body": "Green is mastery or success and nothing else. Violet is never a status; green is never decoration.",
        "section": "colors"
      },
      {
        "name": "The Text Token Rule",
        "body": "Text and glyphs read a text token, never a fill; focus reads focus-ring, a control edge outline, a hairline border. No colour is derived from another.",
        "section": "colors"
      },
      {
        "name": "The Contrast Floor Rule",
        "body": "Text holds 4.5:1 and non-text 3:1 where the palette allows; the palette is fixed (owner 2026-10-10) and the pairs below the floor are the exceptions token_contrast_test lists.",
        "section": "colors"
      },
      {
        "name": "The Seven Roles Rule",
        "body": "Screens use the seven type roles; a new size is a component-level override, never a new global style.",
        "section": "typography"
      },
      {
        "name": "The Text Grows Rule",
        "body": "Text scale is never clamped and no fixed height wraps text.",
        "section": "typography"
      },
      {
        "name": "The 48 Floor Rule",
        "body": "Painted size never sets the touch area; every control keeps a 48x48dp hit area.",
        "section": "layout"
      },
      {
        "name": "The Column Rule",
        "body": "Content never grows wider than 720dp; wide windows gain empty ground.",
        "section": "layout"
      },
      {
        "name": "The Hairline Before Shadow Rule",
        "body": "Group with tone and the 1px border hairline first; shadows only for floating surfaces.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use primary for exactly one primary action per decision, primary-text for indigo text and glyphs, and focus-ring for focus.",
      "Do keep text at 4.5:1 and non-text edges, thumbs and fills at 3:1 on every surface, in both themes.",
      "Do guarantee a 48x48dp touch area on every interactive element, and let text containers grow.",
      "Do write failure copy in the local-first voice: say first that nothing was lost, then offer the retry. Copy is caller-supplied and localized; components hold no copy.",
      "Do use mastery and success green only for mastery and success, and route mastery fills through MasteryRamp.",
      "Do separate groups with tone and the 1px border hairline first.",
      "Do use 12 for every in-flow surface and the defined spacing steps.",
      "Do centre content at a 720dp maximum column and switch to the navigation rail from 600dp."
    ],
    "donts": [
      "Don't use a fill colour as text; use its text token.",
      "Don't use violet or green as decoration, or green for anything but progress and success.",
      "Don't tint shadows with the brand colour, or add elevation where a hairline groups content.",
      "Don't add hover states or a global text style for one component.",
      "Don't put text below 12px or a fixed height around text.",
      "Don't put failure copy in a component, or word a load failure as though data was lost.",
      "Don't introduce an all-caps overline above headings as decoration."
    ]
  }
}
