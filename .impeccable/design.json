  "narrative": {
    "northStar": "The Quiet Study Desk",
    "overview": "MemoX should feel like a quiet, focused study space. One structure, a light and a dark theme, from the owner's \"Flashcard Color Tokens\" spec (ADR-022). Component philosophy: \"Calm and exact\".",
    "keyCharacteristics": [
      "One sans family (Be Vietnam Pro, Noto Sans KR for Korean), twelve roles; interface text 14, only section titles bold.",
      "Tonal surfaces with no resting shadow; cards, search and navigation have no edge.",
      "12 for every card; pills for buttons, search, progress and the navigation pill; 28 for dialogs and sheets.",
      "Compact: 16dp margin, 599dp column, bottom bar; from 600dp: rail, 24dp margin, 1040dp area; 48dp touch targets everywhere.",
      "Every text and edge colour is contrast-tested in both themes; the pairs below AA are recorded exceptions."
    ],
    "rules": [
      {
        "name": "The One Indigo Rule",
        "body": "Indigo means \"act\". A primary fill appears once per decision; the rest of the screen is neutral.",
        "section": "colors"
      },
      {
        "name": "The Green Means Progress Rule",
        "body": "Green is mastery or success and nothing else; green is never decoration.",
        "section": "colors"
      },
      {
        "name": "The Text Token Rule",
        "body": "Text and glyphs read a text token, never a fill; primary on the dark page is a fill only. Focus reads focus-ring, a control edge outline, a hairline inside a card border, a rule on the page divider.",
        "section": "colors"
      },
      {
        "name": "The Contrast Floor Rule",
        "body": "Text holds 4.5:1 and non-text 3:1 where the palette allows; the palette is fixed (spec §2.3, owner 2026-10-13) and the pairs below the floor are the exceptions token_contrast_test.dart records with their measured ratios.",
        "section": "colors"
      },
      {
        "name": "The Twelve Roles Rule",
        "body": "Screens use the twelve TextTheme roles untouched; a component picks a role and a colour, never a size, weight, height or tracking of its own.",
        "section": "typography"
      },
      {
        "name": "The Text Grows Rule",
        "body": "Text scale is never clamped and no fixed height wraps text. Heights are minimums (button 40, app bar 64, field 52, search 56) and grow with wrapped labels and OS text scaling.",
        "section": "typography"
      },
      {
        "name": "The 48 Floor Rule",
        "body": "Painted size never sets the touch area. Buttons paint at 40 or 32; every control keeps a 48x48 hit.",
        "section": "layout"
      },
      {
        "name": "The Column Rule",
        "body": "Content never grows wider than 599dp on a compact window or in a session, or 1040dp from 600; wide windows gain empty ground.",
        "section": "layout"
      },
      {
        "name": "The Tone Before Shadow Rule",
        "body": "A card, the search field and navigation rise by tone alone, with no edge and no shadow; a shadow is only for a surface that floats above content.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use primary for exactly one primary action per decision, primary-text for indigo text and glyphs, and focus-ring for focus.",
      "Do keep text at 4.5:1 and non-text edges, thumbs and fills at 3:1 on every surface, in both themes.",
      "Do guarantee a 48x48dp touch area on every interactive element, and let text containers grow.",
      "Do write failure copy in the local-first voice: say first that nothing was lost, then offer the retry. Copy is caller-supplied and localized; components hold no copy.",
      "Do use mastery and success green only for mastery and success, and route mastery fills through MasteryRamp.",
      "Do separate groups with tone first; use the named shadows only for floating surfaces.",
      "Do use 12 for every card and the defined spacing steps; a screen side margin is context.screenMargin.",
      "Do keep a 599dp column on a compact window and in a session, a 1040dp centred area from 600dp, and switch to the navigation rail from 600dp."
    ],
    "donts": [
      "Don't use a fill colour as text; use its text token.",
      "Don't use violet or green as decoration, or green for anything but progress and success.",
      "Don't tint shadows with the brand colour, or add an edge or a shadow to a card, the search field or navigation.",
      "Don't add hover states or a global text style for one component.",
      "Don't put text below 12px or a fixed height around text.",
      "Don't put failure copy in a component, or word a load failure as though data was lost.",
      "Don't introduce an all-caps overline above headings as decoration."
    ]
  }
}
